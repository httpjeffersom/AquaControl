<Window x:Class="WatercoolerTemp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WatercoolerTemp.Controls"
        Title="Aqua Control"
        Width="390"
        Height="500"
        MinWidth="360"
        MinHeight="380"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#E9F2F0"
        FontFamily="{StaticResource DisplayFont}"
        WindowStartupLocation="CenterScreen"
        Closing="WindowClosing"
        Icon="/Assets/AquaControl.png">

    <Window.Resources>

        <!-- Alterna o conteudo central entre "conectado" e "sem water
             cooler" sem precisar de conversor. -->
        <Style x:Key="ShownWhenConnected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShownWhenDisconnected" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border Background="#0B0E0F"
            BorderBrush="#26302F"
            BorderThickness="1"
            CornerRadius="12"
            Padding="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="DragWindow">

                <TextBlock Text="AQUA CONTROL"
                           FontSize="13"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#9AA8A5" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="−"
                            Click="MinimizeWindow"
                            Style="{StaticResource WindowButton}" />

                    <Button Content="×"
                            Click="CloseWindow"
                            Style="{StaticResource WindowButton}" />

                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Grid Width="290"
                      Height="210">

                    <!-- Sem water cooler: as mesmas 72 bolinhas ficam cheias e
                         vermelhas, na mesma posição (Progress = 1). -->
                    <controls:TemperatureRing>
                        <controls:TemperatureRing.Style>
                            <Style TargetType="controls:TemperatureRing">
                                <Setter Property="Progress" Value="{Binding Progress}" />
                                <Setter Property="IndicatorBrush" Value="{Binding IndicatorBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="False">
                                        <Setter Property="Progress" Value="1" />
                                        <Setter Property="IndicatorBrush" Value="#FF414B" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </controls:TemperatureRing.Style>
                    </controls:TemperatureRing>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                        <!-- Mesma área reservada nos dois estados, para o "USO
                             DE CPU" não pular quando o cooler desaparece. -->
                        <Grid MinHeight="72">

                            <StackPanel VerticalAlignment="Center"
                                        Style="{StaticResource ShownWhenConnected}">

                                <TextBlock Text="TEMPERATURA DA CPU"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Foreground="#778582" />

                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Center"
                                            Margin="0,4,0,0">

                                    <TextBlock Text="{Binding TemperatureText}"
                                               FontFamily="Terminal"
                                               FontSize="46"
                                               Foreground="{Binding IndicatorBrush}" />

                                    <TextBlock Text="°C"
                                               FontSize="13"
                                               Margin="5,24,0,0"
                                               Foreground="{Binding IndicatorBrush}" />

                                </StackPanel>

                            </StackPanel>

                            <TextBlock Text="NENHUM WATERCOOLER ENCONTRADO"
                                       Style="{StaticResource ShownWhenDisconnected}"
                                       FontSize="10"
                                       LineHeight="15"
                                       MaxWidth="150"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#FF6B73" />

                        </Grid>

                        <TextBlock Text="USO DE CPU"
                                   FontSize="9"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"
                                   Foreground="#778582" />

                        <TextBlock Text="{Binding CpuUsageText}"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   Foreground="{Binding CpuUsageBrush}" />
                    </StackPanel>
                </Grid>

                <UniformGrid Rows="1"
                             Columns="3"
                             Width="270"
                             Margin="0,24,0,0">

                    <StackPanel Margin="4,0">

                        <TextBlock Text="MÍNIMA"
                                   FontSize="9"
                                   Foreground="#5F706C"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding MinimumTemperatureText}"
                                   FontSize="13"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                    <StackPanel Margin="4,0">

                        <TextBlock Text="MÉDIA"
                                   FontSize="9"
                                   Foreground="#5F706C"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding AverageTemperatureText}"
                                   FontSize="13"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                    <StackPanel Margin="4,0">

                        <TextBlock Text="MÁXIMA"
                                   FontSize="9"
                                   Foreground="#5F706C"
                                   HorizontalAlignment="Center" />

                        <TextBlock Text="{Binding MaximumTemperatureText}"
                                   FontSize="13"
                                   HorizontalAlignment="Center" />

                    </StackPanel>

                </UniformGrid>

                <CheckBox Content="Iniciar com o Windows"
                          IsChecked="{Binding IsStartupEnabled, Mode=TwoWay}"
                          FontSize="11"
                          Foreground="#778582"
                          HorizontalAlignment="Center"
                          Margin="0,48,0,0" />

            </StackPanel>

        </Grid>

    </Border>

</Window>